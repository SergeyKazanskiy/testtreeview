{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "student-android-preview": {
      "channel": "student-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "student" },
      "android": { "buildType": "apk" }
    },
    "student-ios-preview": {
      "channel": "student-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "student" }
    },
    "student-android-production": {
      "channel": "student-production",
      "distribution": "store",
      "env": { "APP_ROLE": "student" },
      "android": { "buildType": "app-bundle" }
    },
    "student-ios-production": {
      "channel": "student-production",
      "distribution": "store",
      "env": { "APP_ROLE": "student" }
    },

    "coach-android-preview": {
      "channel": "coach-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "coach" },
      "android": { "buildType": "apk" }
    },
    "coach-ios-preview": {
      "channel": "coach-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "coach" }
    },
    "coach-android-production": {
      "channel": "coach-production",
      "distribution": "store",
      "env": { "APP_ROLE": "coach" },
      "android": { "buildType": "app-bundle" }
    },
    "coach-ios-production": {
      "channel": "coach-production",
      "distribution": "store",
      "env": { "APP_ROLE": "coach" }
    },

    "manager-android-preview": {
      "channel": "manager-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "manager" },
      "android": { "buildType": "apk" }
    },
    "manager-ios-preview": {
      "channel": "manager-test",
      "distribution": "internal",
      "env": { "APP_ROLE": "manager" }
    },
    "manager-android-production": {
      "channel": "manager-production",
      "distribution": "store",
      "env": { "APP_ROLE": "manager" },
      "android": { "buildType": "app-bundle" }
    },
    "manager-ios-production": {
      "channel": "manager-production",
      "distribution": "store",
      "env": { "APP_ROLE": "manager" }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "your-apple-id@example.com"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json"
      }
    }
  }
}
