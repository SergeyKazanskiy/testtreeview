{
  "name": "testtreeview",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "deploy": "npx gh-pages -d dist",
    "test": "APP_ROLE=test expo start -c",
    "start:student": "APP_ROLE=student expo start -c",
    "start:coach": "APP_ROLE=coach expo start -c",
    "start:manager": "APP_ROLE=manager expo start -c",
    "test:student": "APP_ROLE=student eas update --branch student-test --message 'Student test update'",
    "test:coach": "APP_ROLE=coach eas update --branch coach-test --message 'Coach test update'",
    "test:manager": "APP_ROLE=manager eas update --branch manager-test --message 'Manager test update'",
    "publish:student": "APP_ROLE=student eas update --branch student --message 'Student OTA update'",
    "publish:coach": "APP_ROLE=coach eas update --branch coach --message 'Coach OTA update'",
    "publish:manager": "APP_ROLE=manager eas update --branch manager --message 'Manager OTA update'",
    "build:student:android:preview": "APP_ROLE=student eas build --platform android --profile student-android-preview",
    "build:student:ios:preview": "APP_ROLE=student eas build --platform ios --profile student-ios-preview",
    "build:coach:android:preview": "APP_ROLE=coach eas build --platform android --profile coach-android-preview",
    "build:coach:ios:preview": "APP_ROLE=coach eas build --platform ios --profile coach-ios-preview",
    "build:manager:android:preview": "APP_ROLE=manager eas build --platform android --profile manager-android-preview",
    "build:manager:ios:preview": "APP_ROLE=manager eas build --platform ios --profile manager-ios-preview",
    "build:student:android:production": "APP_ROLE=student eas build --platform android --profile student-android-production",
    "build:student:ios:production": "APP_ROLE=student eas build --platform ios --profile student-ios-production",
    "build:coach:android:production": "APP_ROLE=coach eas build --platform android --profile coach-android-production",
    "build:coach:ios:production": "APP_ROLE=coach eas build --platform ios --profile coach-ios-production",
    "build:manager:android:production": "APP_ROLE=manager eas build --platform android --profile manager-android-production",
    "build:manager:ios:production": "APP_ROLE=manager eas build --platform ios --profile manager-ios-production"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~54.0.22",
    "expo-checkbox": "^5.0.7",
    "expo-constants": "~18.0.10",
    "expo-device": "^8.0.9",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-image-picker": "~17.0.9",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-notifications": "^0.32.13",
    "expo-router": "^6.0.15",
    "expo-screen-orientation": "^9.0.8",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.8",
    "expo-updates": "~29.0.12",
    "expo-web-browser": "~15.0.9",
    "firebase": "^12.5.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-animatable": "^1.4.0",
    "react-native-chart-kit": "^6.12.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-modal": "^14.0.0-rc.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-signature-canvas": "^5.0.1",
    "react-native-svg": "^15.15.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "gh-pages": "^6.3.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "homepage": "https://sergeykazanskiy.github.io/testtreeview",
  "expo-router": {
    "pruneRoutes": true
  }
}
